<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:id="@+id/studentName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="studentName"
        android:textSize="13sp"
        android:padding="5dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/enrollmentNo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="2"/>

    <TextView
        android:id="@+id/enrollmentNo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="enrollmentNo"
        android:textSize="13sp"
        android:padding="5dp"
        app:layout_constraintStart_toEndOf="@id/studentName"
        app:layout_constraintEnd_toStartOf="@id/batch"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="3"/>

    <TextView
        android:id="@+id/batch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="batch"
        android:textSize="13sp"
        android:padding="5dp"
        android:textAlignment="center"
        app:layout_constraintStart_toEndOf="@id/enrollmentNo"
        app:layout_constraintEnd_toStartOf="@id/idStatus"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="2"/>

    <TextView
        android:id="@+id/idStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="idStatus"
        android:textSize="13sp"
        android:padding="5dp"
        android:textAlignment="center"
        app:layout_constraintStart_toEndOf="@id/batch"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHorizontal_weight="2"/>

</androidx.constraintlayout.widget.ConstraintLayout>