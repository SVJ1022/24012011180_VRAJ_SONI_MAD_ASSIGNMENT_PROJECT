<?xml version="1.0" encoding="utf-8"?>
<!--
    STUDENT LIST / MANAGE DIGITAL IDs SCREEN
    =========================================
    IDs preserved (hard rule):
      main, ModuleTitle, SubTitleModule, searchBar,
      StudentsList, TableCard, header, ListedStudents, backBtn, addBtn

    New IDs:
      searchInputLayout  — TextInputLayout wrapping the real search field
      searchEditText     — TextInputEditText for live search
      tvEmptyState       — "No students found" shown when list is empty

    Changes:
      - Title / subtitle text updated to "Manage Digital IDs"
      - searchBar (M3 SearchBar) kept but gone; replaced by TextInputLayout for
        real TextWatcher + clear-icon support
      - TableCard (column header) kept but hidden by Activity at runtime
      - StudentsList TextView repurposed as the student count label
      - addBtn kept but hidden by Activity (redundant with row tap)
      - tvEmptyState: centered "No students found" TextView
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".StudentListActivity">

    <!-- ── NAVY HEADER ── -->
    <View
        android:id="@+id/listHeaderBand"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:background="@drawable/bg_splash_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Title: "Manage Digital IDs" -->
    <TextView
        android:id="@+id/ModuleTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/lbl_manage_digital_ids"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/colorOnPrimary"
        android:fontFamily="sans-serif"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="52dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/SubTitleModule"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/lbl_manage_digital_ids_sub"
        android:textSize="13sp"
        android:textColor="@color/colorWhite30"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ModuleTitle" />

    <!--
      Original SearchBar ID kept but hidden — Activity uses searchInputLayout instead.
      Hard rule: id must not be removed.
    -->
    <com.google.android.material.search.SearchBar
        android:id="@+id/searchBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/listHeaderBand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── REAL SEARCH FIELD (TextInputLayout) ── -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchInputLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="-28dp"
        android:hint="@string/hint_search_students"
        app:endIconMode="clear_text"
        app:boxBackgroundColor="@color/colorSurface"
        app:boxCornerRadiusTopStart="28dp"
        app:boxCornerRadiusTopEnd="28dp"
        app:boxCornerRadiusBottomStart="28dp"
        app:boxCornerRadiusBottomEnd="28dp"
        app:layout_constraintTop_toBottomOf="@id/listHeaderBand"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- ── STUDENT COUNT LABEL (original id: StudentsList) ── -->
    <TextView
        android:id="@+id/StudentsList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 students"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextSecondary"
        android:letterSpacing="0.06"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchInputLayout" />

    <!--
      Original table header card — kept with all IDs; hidden at runtime by Activity.
      Hard rule: id=TableCard and id=header must not be removed.
    -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/TableCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="0dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/colorPrimary"
        app:layout_constraintTop_toBottomOf="@id/StudentsList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="0,1,2,3">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@string/col_name"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/colorOnPrimary"
                    android:textAlignment="center"
                    android:padding="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="3"
                    android:text="@string/col_enrollment"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/colorOnPrimary"
                    android:textAlignment="center"
                    android:padding="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@string/col_batch"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/colorOnPrimary"
                    android:textAlignment="center"
                    android:padding="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:text="@string/col_id_status"
                    android:textStyle="bold"
                    android:textSize="12sp"
                    android:textColor="@color/colorOnPrimary"
                    android:textAlignment="center"
                    android:padding="10dp" />

            </TableRow>

        </TableLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ── EMPTY STATE ── -->
    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_no_students_found"
        android:textSize="15sp"
        android:textColor="@color/colorTextSecondary"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/StudentsList"
        app:layout_constraintBottom_toTopOf="@id/backBtn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── RECYCLER VIEW ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ListedStudents"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        android:paddingBottom="72dp"
        app:layout_constraintTop_toBottomOf="@id/StudentsList"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ── BACK BUTTON ── -->
    <Button
        android:id="@+id/backBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_back"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        style="@style/Widget.App.Button.Outlined"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ── ADD BUTTON (kept, hidden at runtime) ── -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/addBtn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="@string/btn_add_student"
        android:text="Assign"
        android:visibility="gone"
        app:backgroundTint="@color/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_add"
        app:tint="@color/colorOnPrimary" />

</androidx.constraintlayout.widget.ConstraintLayout>