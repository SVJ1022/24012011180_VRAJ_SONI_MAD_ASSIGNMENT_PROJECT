<?xml version="1.0" encoding="utf-8"?>
<!--
    USER MANAGEMENT SCREEN
    IDs: main, userMgmtTitle, userMgmtSubtitle,
         searchInputLayout, searchEditText,
         tvUserCount, tvUsersEmptyState,
         ListedUsers, fabAddUser
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".UserManagementActivity">

    <!-- ── NAVY HEADER ── -->
    <View
        android:id="@+id/userMgmtHeader"
        android:layout_width="0dp"
        android:layout_height="150dp"
        android:background="@drawable/bg_splash_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/userMgmtTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/lbl_user_management_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/colorOnPrimary"
        android:fontFamily="sans-serif"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="52dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/userMgmtSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/lbl_user_management_sub"
        android:textSize="13sp"
        android:textColor="@color/colorWhite30"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/userMgmtTitle" />

    <!-- ── SEARCH FIELD ── -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/searchInputLayout"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="-28dp"
        android:hint="@string/hint_search_users"
        app:endIconMode="clear_text"
        app:boxBackgroundColor="@color/colorSurface"
        app:boxCornerRadiusTopStart="28dp"
        app:boxCornerRadiusTopEnd="28dp"
        app:boxCornerRadiusBottomStart="28dp"
        app:boxCornerRadiusBottomEnd="28dp"
        app:layout_constraintTop_toBottomOf="@id/userMgmtHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/searchEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- ── COUNT LABEL ── -->
    <TextView
        android:id="@+id/tvUserCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 users"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/colorTextSecondary"
        android:letterSpacing="0.06"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchInputLayout" />

    <!-- ── EMPTY STATE ── -->
    <TextView
        android:id="@+id/tvUsersEmptyState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_no_users_found"
        android:textSize="15sp"
        android:textColor="@color/colorTextSecondary"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tvUserCount"
        app:layout_constraintBottom_toTopOf="@id/fabAddUser"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ── RECYCLER VIEW ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ListedUsers"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp"
        app:layout_constraintTop_toBottomOf="@id/tvUserCount"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- ── FLOATING ACTION BUTTON: Add User ── -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddUser"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="@string/btn_add_user"
        app:srcCompat="@drawable/ic_add"
        app:backgroundTint="@color/colorPrimary"
        app:tint="@color/colorOnPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
