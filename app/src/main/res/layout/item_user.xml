<?xml version="1.0" encoding="utf-8"?>
<!--
    USER LIST ITEM ROW
    IDs: avatarInitial, tvUserName, tvUserEmail, tvUserPhone, tvUserBatch, tvUserRole
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/colorSurface"
    app:rippleColor="@color/colorSurfaceVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- ── AVATAR INITIAL ── -->
        <TextView
            android:id="@+id/avatarInitial"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:text="U"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnPrimary"
            android:fontFamily="sans-serif" />

        <!-- ── DETAILS ── -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <!-- Full name -->
            <TextView
                android:id="@+id/tvUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User Name"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary"
                android:fontFamily="sans-serif"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- Email -->
            <TextView
                android:id="@+id/tvUserEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="email@example.com"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1" />

            <!-- Phone · Batch -->
            <TextView
                android:id="@+id/tvUserPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9876543210"
                android:textSize="12sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginTop="1dp" />

            <!-- Batch (kept separate for search filtering reference) -->
            <TextView
                android:id="@+id/tvUserBatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2024–2028"
                android:textSize="11sp"
                android:textColor="@color/colorTextSecondary"
                android:layout_marginTop="1dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- ── ROLE CHIP ── -->
        <TextView
            android:id="@+id/tvUserRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Student"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnPrimary"
            android:background="@drawable/bg_chip_warning"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:layout_marginStart="8dp"
            android:gravity="center" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
