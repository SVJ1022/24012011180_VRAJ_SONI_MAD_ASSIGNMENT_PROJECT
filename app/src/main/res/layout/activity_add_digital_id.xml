<?xml version="1.0" encoding="utf-8"?>
<!--
    ADD / UPDATE DIGITAL ID
    ScrollView → ConstraintLayout(R.id.main).
    Circular photo preview with camera-icon overlay.
    Outlined inputs with icons (Enrollment, College, Degree, Blood Group, Validity).
    Full-width Save button. Back button top-left.
    IDs preserved: main, ModuleTitle, StudentName,
                   EnrollmentLayout, enrollmentNo,
                   CollegeLayout, college,
                   DegreeLayout, degree,
                   BGroupLayout, bGroup,
                   ValidityLayout, validity,
                   uploadPhoto, saveDigitalID, backBtn
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".AddDigitalIDActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="24dp">

        <!-- ── NAVY HEADER ── -->
        <View
            android:id="@+id/addIdHeaderBand"
            android:layout_width="0dp"
            android:layout_height="140dp"
            android:background="@drawable/bg_splash_gradient"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Back button in header (top-left) -->
        <Button
            android:id="@+id/backBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_back"
            android:textColor="@color/colorOnPrimary"
            android:layout_marginStart="12dp"
            android:layout_marginTop="12dp"
            style="@style/Widget.App.Button.Text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Module title in header -->
        <TextView
            android:id="@+id/ModuleTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/lbl_digital_id_management"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnPrimary"
            android:fontFamily="sans-serif"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="52dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Student name sub-heading in header -->
        <TextView
            android:id="@+id/StudentName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Student Name"
            android:textSize="14sp"
            android:textColor="@color/colorWhite30"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="2dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ModuleTitle" />

        <!-- ── WHITE FORM CARD ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/formCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="-24dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/colorSurface"
            app:layout_constraintTop_toBottomOf="@id/addIdHeaderBand"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- ── CIRCULAR PHOTO PREVIEW ── -->
                <FrameLayout
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="20dp">

                    <!-- The actual photo (ID used by Kotlin: uploadPhoto) -->
                    <ImageView
                        android:id="@+id/uploadPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_photo_ring"
                        android:padding="3dp"
                        android:contentDescription="@string/cd_upload_photo"
                        android:clickable="true"
                        android:focusable="true"
                        app:srcCompat="@drawable/cloud_upload" />

                    <!-- Camera icon overlay (bottom-right) -->
                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_gravity="bottom|end"
                        android:layout_margin="4dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:padding="6dp"
                        android:contentDescription="@string/cd_camera_icon"
                        android:clickable="false"
                        app:srcCompat="@drawable/ic_camera"
                        app:tint="@color/colorOnPrimary" />

                </FrameLayout>

                <!-- Enrollment No. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/EnrollmentLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_enrollment"
                    app:startIconDrawable="@drawable/ic_badge"
                    app:startIconTint="@color/colorPrimary"
                    style="@style/Widget.App.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/enrollmentNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:textColor="@color/colorTextPrimary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- College -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/CollegeLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_college"
                    android:layout_marginTop="14dp"
                    app:startIconDrawable="@drawable/ic_school"
                    app:startIconTint="@color/colorPrimary"
                    style="@style/Widget.App.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/college"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/colorTextPrimary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Degree -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/DegreeLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_degree"
                    android:layout_marginTop="14dp"
                    app:startIconDrawable="@drawable/ic_school"
                    app:startIconTint="@color/colorPrimary"
                    style="@style/Widget.App.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/degree"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/colorTextPrimary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Blood Group -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/BGroupLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_blood_group"
                    android:layout_marginTop="14dp"
                    app:startIconDrawable="@drawable/ic_person"
                    app:startIconTint="@color/colorError"
                    style="@style/Widget.App.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/bGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/colorTextPrimary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Validity -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/ValidityLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_validity"
                    android:layout_marginTop="14dp"
                    app:startIconDrawable="@drawable/ic_calendar"
                    app:startIconTint="@color/colorPrimary"
                    style="@style/Widget.App.TextInputLayout">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/validity"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/colorTextPrimary" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Save button — full-width, pinned at end of form -->
                <Button
                    android:id="@+id/saveDigitalID"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_save_digital_id"
                    android:layout_marginTop="24dp"
                    style="@style/Widget.App.Button.Primary" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>