<?xml version="1.0" encoding="utf-8"?>
<!--
    MAIN / WELCOME SCREEN
    Navy hero header (~45% height) with logo + title.
    Filled Login button and outlined Sign Up button on light background below.
    IDs preserved: main, imageContainer_activity_main, main_logo,
                   digitalId, fullAppName, LoginBtn, NewSignUp, SignUpBtn
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    tools:context=".MainActivity">

    <!-- ── HERO HEADER BAND ── -->
    <View
        android:id="@+id/heroBand"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_splash_gradient"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/LoginBtn" />

    <!-- Logo container (white semi-transparent circle in hero) -->
    <FrameLayout
        android:id="@+id/imageContainer_activity_main"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:background="@drawable/bg_logo_circle"
        android:padding="16dp"
        android:layout_marginTop="64dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/main_logo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:contentDescription="@string/cd_app_logo"
            app:srcCompat="@drawable/digital_id_logo" />

    </FrameLayout>

    <!-- App title in hero -->
    <TextView
        android:id="@+id/digitalId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_digital_id"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="@color/colorOnPrimary"
        android:fontFamily="sans-serif"
        android:letterSpacing="0.12"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageContainer_activity_main" />

    <!-- Subtitle in hero -->
    <TextView
        android:id="@+id/fullAppName"
        android:layout_width="260dp"
        android:layout_height="wrap_content"
        android:text="@string/app_full_name"
        android:textSize="14sp"
        android:textColor="@color/colorWhite30"
        android:textAlignment="center"
        android:fontFamily="sans-serif"
        android:lineSpacingMultiplier="1.3"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/digitalId" />

    <!-- Sign Up helper text -->
    <TextView
        android:id="@+id/NewSignUp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/lbl_new_to_digital_id"
        android:textSize="13sp"
        android:textColor="@color/colorTextSecondary"
        android:layout_marginTop="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/LoginBtn" />

    <!-- Login button — filled primary, full-width -->
    <Button
        android:id="@+id/LoginBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_login"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="240dp"
        style="@style/Widget.App.Button.Primary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Sign Up button — outlined, full-width -->
    <Button
        android:id="@+id/SignUpBtn"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/btn_signup"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="12dp"
        style="@style/Widget.App.Button.Outlined"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/NewSignUp" />

</androidx.constraintlayout.widget.ConstraintLayout>